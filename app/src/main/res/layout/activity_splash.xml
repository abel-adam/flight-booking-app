<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_et">

    <!-- Subtle pattern layer for depth -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-80dp"
        android:alpha="0.06"
        android:background="@drawable/circle_white_20" />

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="-60dp"
        android:layout_marginBottom="-60dp"
        android:alpha="0.06"
        android:background="@drawable/circle_white_20" />

    <!-- Centered logo + tagline -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo container with soft white ring -->
        <RelativeLayout
            android:id="@+id/logoContainer"
            android:layout_width="140dp"
            android:layout_height="140dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.2"
                android:background="@drawable/circle_white_20" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_centerInParent="true"
                android:contentDescription="Ethiopian Airlines Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/app_logo" />
        </RelativeLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="-0.02"
            android:text="Ethioairlines"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.12"
            android:text="THE NEW SPIRIT OF AFRICA"
            android:textColor="@color/white"
            android:alpha="0.9"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Gold accent underline -->
        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="16dp"
            android:background="@color/accent_et"
            android:alpha="0.9" />

        <!-- Progress indicator -->
        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/white" />
    </LinearLayout>

    <!-- Floating plane (positioned to fly across bottom third) -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/floatingPlane"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        android:contentDescription="Flying Plane"
        android:elevation="8dp"
        android:src="@drawable/ethiopian_plane"
        app:civ_border_color="@color/white_60"
        app:civ_border_width="2dp" />

</RelativeLayout>
