<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_slate"
    android:orientation="vertical">

    <!-- Brand Green Header (My Bookings style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_gradient_premium"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_chevron_left"
                app:tint="#1E293B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Book Flight"
                android:textColor="#1E293B"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Tab selector: pill on green bg -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_segmented_control"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabOneWay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_item_selected"
                android:gravity="center"
                android:text="@string/one_way"
                android:textColor="@color/primary_et"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabRoundTrip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/round_trip"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabMultiCity"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/multi_city"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp">


            <!-- Main Search Form / Card 1 (Leg 1) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvLeg1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flight 1"
                        android:textColor="@color/primary_et"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/layoutMcLeg1Summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvMcLeg1Route"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Addis Ababa (ADD) - Dubai (DXB)" />
                    </LinearLayout>

                        <TextView
                            android:id="@+id/tvDepartureDateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/departure_date"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />

                        <RelativeLayout
                            android:id="@+id/layoutDate"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/edittext_modern">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="16dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_calendar"
                                app:tint="@color/brand_green" />

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="48dp"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            tools:text="12 April 2026" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/layoutReturnDateContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:text="@string/return_date"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1" />

                            <RelativeLayout
                                android:id="@+id/layoutReturnDate"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/edittext_modern">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="16dp"
                                    android:contentDescription="@null"
                                    app:srcCompat="@drawable/ic_calendar"
                                    app:tint="@color/brand_green" />

                            <TextView
                                android:id="@+id/tvReturnDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="48dp"
                                android:text="@string/select_return_date"
                                android:textColor="@color/text_secondary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2 (Leg 2) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutMcLeg2Block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flight 2"
                        android:textColor="@color/primary_et"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/edittext_bg">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_location_pin"
                            app:tint="@color/text_secondary" />

                        <AutoCompleteTextView
                            android:id="@+id/etMc2From"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="48dp"
                            android:background="@android:color/transparent"
                            android:completionThreshold="0"
                            android:hint="@string/from_label"
                            android:inputType="text"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/edittext_bg">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_location_pin"
                            app:tint="@color/text_secondary" />

                        <AutoCompleteTextView
                            android:id="@+id/etMc2To"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="48dp"
                            android:background="@android:color/transparent"
                            android:completionThreshold="0"
                            android:hint="@string/to_label"
                            android:inputType="text"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/layoutMc2Date"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/edittext_bg">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_calendar"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvMc2Date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="48dp"
                            android:text="@string/select_date"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preferences Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/passengers"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.1" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/edittext_bg"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">

                                <ImageView
                                    android:id="@+id/btnDecrease"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/counter_btn_bg"
                                    android:contentDescription="@string/decrease"
                                    android:padding="6dp"
                                    app:srcCompat="@drawable/ic_chevron_left"
                                    app:tint="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvPassengerCount"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/btnIncrease"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/counter_btn_bg"
                                    android:contentDescription="@string/increase"
                                    android:padding="6dp"
                                    app:srcCompat="@drawable/ic_chevron_right"
                                    app:tint="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/cabin_class"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />

                        <RelativeLayout
                            android:id="@+id/layoutTravelClass"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/edittext_modern">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="16dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_suitcase"
                                app:tint="@color/brand_green" />

                        <TextView
                            android:id="@+id/tvTravelClass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="48dp"
                            android:text="@string/economy"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_chevron_down"
                            app:tint="@color/text_secondary" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindFlights"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@null"
                android:background="@drawable/btn_premium_capsule"
                android:text="@string/find_flights"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:elevation="4dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
