<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light-only theme: DayNight caused invisible typed text on light input backgrounds when the device is in dark mode. -->
    <style name="Base.Theme.FlightBooking" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_et</item>
        <item name="colorPrimaryVariant">@color/primary_dark_et</item>
        <item name="colorSecondary">@color/accent_et</item>
        <item name="android:statusBarColor">@color/primary_et</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="textInputStyle">@style/Widget.FlightBooking.TextInputLayout</item>
        <item name="android:windowBackground">@color/surface_slate</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.FlightBooking.Button.Primary</item>
    </style>

    <style name="Theme.FlightBooking" parent="Base.Theme.FlightBooking" />

    <style name="Widget.FlightBooking.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxStrokeColor">@color/primary_et</item>
        <item name="boxBackgroundColor">@color/input_fill</item>
        <item name="boxBackgroundMode">filled</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="hintTextColor">@color/primary_et</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="hintEnabled">true</item>
        <item name="hintAnimationEnabled">true</item>
    </style>


    <style name="Widget.FlightBooking.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Bottom sheet with rounded top corners -->
    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppBottomSheetStyle</item>
    </style>

    <style name="AppBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/RoundedBottomSheetShape</item>
    </style>

    <style name="RoundedBottomSheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <!-- Premium Button Style -->
    <style name="Widget.FlightBooking.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">32dp</item>
        <item name="elevation">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="OtpEditTextStyle">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
