<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/card_bg">

        <!-- Header: Flight Info & Status -->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: SG-2938"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/badge_confirmed"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Confirmed"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Flight Path (mt-4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvFromCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADD" android:textColor="@color/text_main" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 Jun 2024" android:textColor="@color/text_muted" android:textSize="11sp" />
            </LinearLayout>

            <ImageView android:layout_width="32dp" android:layout_height="16dp" android:src="@drawable/ic_flight_path" android:layout_marginHorizontal="12dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical">
                <TextView android:id="@+id/tvToCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DXB" android:textColor="@color/text_main" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvPassenger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="John Doe" android:textColor="@color/text_muted" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer: Price & Details Button -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background" android:layout_marginVertical="16dp" />

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$495.00"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="View Ticket"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
