<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/card_bg">

        <!-- Airline & Price Header -->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/logoCard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/slate_50"> <!-- bg-slate-50 -->
                <ImageView
                    android:id="@+id/ivAirlineLogo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plane"
                    android:tint="@color/primary" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvAirlineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/logoCard"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:text="SkyGlide Airways"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="$450"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Flight Path (mt-5) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvFromCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADD" android:textColor="@color/text_main" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvFromTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:00 AM" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <RelativeLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:layout_marginHorizontal="12dp">
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/slate_200" android:layout_centerInParent="true" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_centerInParent="true" android:src="@drawable/ic_plane" android:tint="@color/slate_300" android:rotation="90" android:background="@color/white" android:padding="2dp" />
            </RelativeLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical">
                <TextView android:id="@+id/tvToCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DXB" android:textColor="@color/text_main" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvToTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="02:30 PM" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Book Button (mt-5) -->
        <Button
            android:id="@+id/btnBook"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Book Now"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
